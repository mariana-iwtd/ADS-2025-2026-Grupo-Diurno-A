<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Grupo_Diurno_A.Controller">
   <children>
      <VBox fx:id="vBoxInicial" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" StackPane.alignment="CENTER">
         <children>
            <ImageView fx:id="logotipo" fitHeight="223.0" fitWidth="391.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="labelPE" text="Pasta Escolhida:" />
            <Label fx:id="pastaEscolhida" alignment="CENTER" text="Label" textAlignment="CENTER" />
            <Button fx:id="botaoEscolhaProjeto" alignment="CENTER" mnemonicParsing="false" onAction="#onSelecionarPasta" text="Escolha o Projeto Java" textAlignment="CENTER" textFill="#0f3b6d" />
            <Button fx:id="botaoAnalisar" mnemonicParsing="false" onAction="#onAnalisar" text="Analisar Codigo">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
      <BorderPane fx:id="paneResultados" prefHeight="200.0" prefWidth="200.0">
         <center>
            <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <TableView fx:id="tabela" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="150.0" text="Classe" />
                        <TableColumn fx:id="colLOC" prefWidth="60.0" text="LOC" />
                        <TableColumn fx:id="colNOM" prefWidth="60.0" text="NOM" />
                        <TableColumn fx:id="colNOA" prefWidth="60.0" text="NOA" />
                        <TableColumn fx:id="colDIT" prefWidth="60.0" text="DIT" />
                        <TableColumn fx:id="colNOC" prefWidth="60.0" text="NOC" />
                        <TableColumn fx:id="colCBO" prefWidth="60.0" text="CBO" />
                        <TableColumn fx:id="colCC" prefWidth="80.0" text="CC" />
                        <TableColumn fx:id="colNPRM" prefWidth="80.0" text="NPRM" />
                        <TableColumn fx:id="colAvgLOC" prefWidth="120.0" text="Avg LOC/Method" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <BarChart fx:id="grafico" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                    <xAxis>
                      <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                      <NumberAxis side="LEFT" />
                    </yAxis>
                  </BarChart>
               </children>
            </StackPane>
         </center>
         <top>
            <HBox fillHeight="false" spacing="5.0" styleClass="cabecalho-azul" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="botaoVoltar" mnemonicParsing="false" onAction="#onVoltar" styleClass="button-menu" text="←">
                     <HBox.margin>
                        <Insets right="40.0" />
                     </HBox.margin></Button>
                  <Button fx:id="botaoTabela" mnemonicParsing="false" onAction="#onBotaoTabela" styleClass="button-menu" text="Todos" />
                  <Button fx:id="botaoLOC" mnemonicParsing="false" onAction="#onLOC" styleClass="button-menu" text="LOC" />
                  <Button fx:id="botaoNOM" mnemonicParsing="false" onAction="#onNOM" styleClass="button-menu" text="NOM" />
                  <Button fx:id="botaoNOA" mnemonicParsing="false" onAction="#onNOA" styleClass="button-menu" text="NOA" />
                  <Button fx:id="botaoDIT" mnemonicParsing="false" onAction="#onDIT" styleClass="button-menu" text="DIT" />
                  <Button fx:id="botaoNOC" mnemonicParsing="false" onAction="#onNOC" styleClass="button-menu" text="NOC" />
                  <Button fx:id="botaoCBO" mnemonicParsing="false" onAction="#onCBO" styleClass="button-menu" text="CBO" />
                  <Button fx:id="botaoCC" mnemonicParsing="false" onAction="#onCC" prefHeight="27.0" prefWidth="46.0" styleClass="button-menu" text="MCC" />
                  <Button fx:id="botaoNPRM" mnemonicParsing="false" onAction="#onNPRM" styleClass="button-menu" text="NPRM" />
                  <Button fx:id="botaoAvgLOCMethod" mnemonicParsing="false" onAction="#onAvgLOC" styleClass="button-menu" text="AvgLOC" />
               </children>
            </HBox>
         </top>
         <bottom>
            <HBox alignment="CENTER" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="botaoExportar" mnemonicParsing="false" onAction="#onExportar" text="Exportar para CSV" />
               </children>
               <BorderPane.margin>
                  <Insets bottom="5.0" top="5.0" />
               </BorderPane.margin>
            </HBox>
         </bottom></BorderPane>
   </children>
</StackPane>
